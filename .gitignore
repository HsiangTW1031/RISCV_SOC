# Simulation build artifacts
**/obj_dir/
**/obj_dir_*/
**/dv/*.vcd
**/dv/*.fst
**/dv/firmware.hex

# Synthesis outputs / reports (regenerated by run_flow.sh)
**/syn/*_out.v
**/syn/*_out.json
**/syn/*_generic.v
**/syn/synth_report.txt
**/syn/synth_nangate45_report.txt
**/syn/synth_log.txt
**/syn/synth_generic_log.txt
**/syn/lec_log.txt

# Lint / STA reports (regenerated by run_flow.sh)
**/lint/lint_report.txt
**/sta/sta_report.txt
**/sta/sta_log.txt
**/sta/sta_mcmm_log.txt

# scripts/run_regression.sh build logs / ad-hoc debug build logs
**/*_build.log
**/dv/build*.log
**/dv/coverage.dat

# Coverage raw databases (regenerated by scripts/run_coverage.sh) -- large,
# regenerable; reports/sign_off/dashboard.html + dashboard_data.json +
# coverage/hier_report.txt are the committed, curated summary.
reports/sign_off/coverage/dat/
reports/sign_off/coverage/merged.dat
reports/sign_off/coverage/coverage.info
reports/sign_off/coverage/annotated/

# Firmware build artifacts
fw/*.o
fw/*.elf
fw/*.bin
fw/*.hex
fw/*.map

# Toolchain/source archives that shouldn't end up in the repo
*.tar.gz

# macOS
.DS_Store
