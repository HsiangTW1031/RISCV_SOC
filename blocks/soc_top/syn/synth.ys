# Yosys synthesis script for the whole SoC (Phase 7 sign-off), targeting
# the Nangate45 open-cell library.
#
# The three plain memory arrays (boot_rom's 64KB ROM, sram's 128KB RAM,
# dma_ram's 8KB scratch buffer) are swapped for blackbox stand-ins
# (mem_blackboxes.v) instead of their real `reg [31:0] mem [...]` bodies --
# in a real ASIC flow these would be hardened SRAM macros, not synthesized
# flip-flops, and letting Yosys actually flatten a 32K-word array into
# 1M+ flip-flops would be both unrepresentative and impractically slow.
# Everything else -- PicoRV32, the hand-written crossbar, every
# peripheral's control/datapath logic, the AES core + CBC/CTR chaining,
# and the DMA engine -- is synthesized for real. This is what makes the
# Fmax number in docs/performance.md a genuine logic-critical-path result,
# not a memory-dominated one.
#
# Run from blocks/soc_top/syn/:
#   yosys synth.ys
read_verilog -I../../../rtl/include -I../rtl \
    mem_blackboxes.v \
    ../rtl/picorv32.v \
    ../rtl/axi_lite_xbar.v \
    ../rtl/timer.v \
    ../rtl/watchdog.v \
    ../rtl/uart.v \
    ../rtl/i2c_master.v \
    ../rtl/spi_master.v \
    ../rtl/aes_key_expand.v \
    ../rtl/aes_core.v \
    ../rtl/aes_chain.v \
    ../rtl/aes.v \
    ../rtl/dma_engine.v \
    ../rtl/jtag_tap.v \
    ../rtl/jtag_dtm.v \
    ../rtl/jtag_axi_bridge.v \
    ../rtl/soc_top.v

hierarchy -check -top soc_top
synth -top soc_top

dfflibmap -liberty /Users/shunghsiangwu/eda/nangate45/lib/NangateOpenCellLibrary_typical.lib
abc -liberty /Users/shunghsiangwu/eda/nangate45/lib/NangateOpenCellLibrary_typical.lib

clean
write_verilog soc_top_out.v
write_json soc_top_out.json

stat -liberty /Users/shunghsiangwu/eda/nangate45/lib/NangateOpenCellLibrary_typical.lib
