# Generic (pre-technology-mapping) gate-level netlist for soc_top, used
# only by scripts/run_gatelevel_sim.sh's gate-level simulation -- distinct
# from synth.ys's real Nangate45-mapped netlist (soc_top_out.v, used for
# STA/gate count/Fmax).
#
# This stops right after `synth -top soc_top`, deliberately skipping
# dfflibmap/abc -liberty: without a functional Verilog model for every
# Nangate45 standard cell (this machine only has functional models for
# latch/clock-gate/adder cells, not the full basic-gate set), the real
# tech-mapped netlist can't be simulated directly. Yosys's own internal
# generic cells ($_AND_, $_DFF_P_, etc.) are different: `write_verilog`
# expands them into plain behavioral Verilog automatically, which
# Verilator can compile with no external cell library at all. Simulating
# this generic netlist still answers the real question gate-level sim is
# for -- did logic synthesis/optimization change behavior -- just without
# also covering the technology-mapping step (that step is instead checked
# formally, see docs/lec_report.md).
#
# Same blackbox treatment for boot_rom/sram/dma_ram as synth.ys, for the
# same reason (a 32K-word array synthesized into flip-flops is slow and
# unrepresentative) -- but scripts/run_gatelevel_sim.sh swaps in the real
# rtl/{boot_rom,sram,dma_ram}.v bodies at simulation time instead of
# these blackboxes, since a gate-level *simulation* run (unlike STA) needs
# real memory contents/behavior for the firmware-boot test to mean
# anything.
#
# Run from blocks/soc_top/syn/:
#   yosys synth_generic.ys
read_verilog -I../../../rtl/include -I../rtl \
    mem_blackboxes.v \
    ../rtl/picorv32.v \
    ../rtl/axi_lite_xbar.v \
    ../rtl/timer.v \
    ../rtl/watchdog.v \
    ../rtl/uart.v \
    ../rtl/i2c_master.v \
    ../rtl/spi_master.v \
    ../rtl/aes_key_expand.v \
    ../rtl/aes_core.v \
    ../rtl/aes_chain.v \
    ../rtl/aes.v \
    ../rtl/dma_engine.v \
    ../rtl/jtag_tap.v \
    ../rtl/jtag_dtm.v \
    ../rtl/jtag_axi_bridge.v \
    ../rtl/soc_top.v

hierarchy -check -top soc_top
synth -top soc_top

clean
write_verilog soc_top_generic.v
